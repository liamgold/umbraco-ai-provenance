<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The Umbraco test builders and NUnit asserts are not annotated for nullable reference types. -->
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Tests.Integration" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umbraco.Community.AIProvenance\Umbraco.Community.AIProvenance.csproj" />
    <ProjectReference Include="..\..\src\Umbraco.Community.AIProvenance.UmbracoAI\Umbraco.Community.AIProvenance.UmbracoAI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.Tests.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
