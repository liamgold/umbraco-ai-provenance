<?xml version="1.0" encoding="utf-8"?>
<!-- Restore from nuget.org only, so every build uses the same package source, whatever a developer's own NuGet settings contain. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
