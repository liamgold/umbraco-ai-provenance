<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Umbraco.Community.AIProvenance.UmbracoAI</Product>
    <PackageId>Umbraco.Community.AIProvenance.UmbracoAI</PackageId>
    <Title>AI Provenance for Umbraco.AI</Title>
    <Description>Marks content as AI generated or AI modified automatically when Umbraco.AI agents change it. An add-on for Umbraco.Community.AIProvenance.</Description>
    <PackageTags>umbraco umbraco-marketplace umbraco-ai ai ai-provenance ai-disclosure ai-label transparency</PackageTags>
    <Authors>Liam Goldfinch</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Liam Goldfinch</Copyright>
    <PackageProjectUrl>https://github.com/liamgold/umbraco-ai-provenance</PackageProjectUrl>
    <RepositoryUrl>https://github.com/liamgold/umbraco-ai-provenance</RepositoryUrl>
    <PackageReadmeFile>README_nuget_UmbracoAI.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The full package, not Umbraco.AI.Core: Core alone does not register the services that its own types need. -->
    <PackageReference Include="Umbraco.AI" />
    <!--
      The handler uses Umbraco's content notifications and services directly. The Umbraco Marketplace also lists
      only packages with a direct dependency on an Umbraco.Cms package.
    -->
    <PackageReference Include="Umbraco.Cms.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.AIProvenance\Umbraco.Community.AIProvenance.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.AIProvenance.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\README_nuget_UmbracoAI.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <!-- NuGet and the Umbraco Marketplace show this icon. Its source is docs/icon/icon.html. -->
    <None Include="..\..\docs\icon\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
