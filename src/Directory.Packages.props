<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms" Version="[17.8.1, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="[17.8.1, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[17.8.1, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[17.8.1, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[17.8.1, 17.999.999)" />
    <!-- The version Umbraco 17.8.1 resolves. -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- The Umbraco.AI add-on depends on the full Umbraco.AI package: Umbraco.AI.Core alone does not register its own services. -->
    <PackageVersion Include="Umbraco.AI" Version="[17.8.0, 17.999.999)" />
    <!-- The test site only, to run Umbraco.AI agents. -->
    <PackageVersion Include="Umbraco.AI.Agent" Version="17.4.3" />
    <PackageVersion Include="Umbraco.AI.Agent.Copilot" Version="17.2.1" />
    <PackageVersion Include="Umbraco.AI.MicrosoftFoundry" Version="17.0.6" />
    <PackageVersion Include="uSync" Version="17.0.0" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>

</Project>
