<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- Compiles the MVC views in Views/, such as the AI label partial, into the package. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Umbraco.Community.AIProvenance</Product>
    <PackageId>Umbraco.Community.AIProvenance</PackageId>
    <Title>AI Provenance</Title>
    <Description>Records where AI was involved in Umbraco content, property by property. Editors mark properties as AI generated or AI modified, and websites and the Delivery API show AI labels.</Description>
    <PackageTags>umbraco ai ai-provenance ai-disclosure ai-label transparency eu-ai-act</PackageTags>
    <Authors>Liam Goldfinch</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Liam Goldfinch</Copyright>
    <PackageProjectUrl>https://github.com/liamgold/umbraco-ai-provenance</PackageProjectUrl>
    <RepositoryUrl>https://github.com/liamgold/umbraco-ai-provenance</RepositoryUrl>
    <PackageReadmeFile>README_nuget.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon></PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the tests use internal types, such as the reader. -->
    <InternalsVisibleTo Include="Umbraco.Community.AIProvenance.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Api.Delivery" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dont include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\README_nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
